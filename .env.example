PORT=8080
# true = HTTPS com certificado autoassinado (necessário para o óculos acessar pelo IP da rede)
HTTPS=false
# URL de produção do webhook do workflow "[TRIGGER] VR Botão Sala"
N8N_WEBHOOK_URL=https://n8n.eltonrosa.site/webhook/vr-botao
# Segredo enviado no header X-VR-Secret (o workflow n8n confere)
N8N_WEBHOOK_SECRET=troque-este-segredo

# Sala 5B — login do profissional. Gere hash e segredo com: npm run criar-senha -- "sua senha"
TERAPEUTA_USUARIO=terapeuta
TERAPEUTA_SENHA_HASH=
SESSION_SECRET=
# Na VPS atrás do proxy HTTPS: TRUST_PROXY=true e COOKIE_SECURE=true
TRUST_PROXY=false
COOKIE_SECURE=false
